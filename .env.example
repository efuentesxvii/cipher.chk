# Password Security Analyzer — environment variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to GitHub — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env
#   Then edit .env with your actual values.

# -------------------------------------------------------
# API server
# -------------------------------------------------------

# Host and port the FastAPI server binds to
API_HOST=0.0.0.0
API_PORT=8000

# Set to "development" or "production"
# In production, disables /docs and /redoc endpoints
ENVIRONMENT=development

# -------------------------------------------------------
# CORS
# -------------------------------------------------------

# Comma-separated list of allowed frontend origins
# Example: https://yourusername.github.io,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# -------------------------------------------------------
# Rate limiting
# -------------------------------------------------------

# Requests per minute per IP for the /analyze endpoint
ANALYZE_RATE_LIMIT=30

# Requests per minute per IP for the /breach-check endpoint
# Lower than analyze because it proxies to an external API
BREACH_CHECK_RATE_LIMIT=10

# -------------------------------------------------------
# External APIs
# -------------------------------------------------------

# HaveIBeenPwned API base URL (no trailing slash)
# Change only if using a self-hosted HIBP mirror
HIBP_API_URL=https://api.pwnedpasswords.com

# Timeout in seconds for HIBP requests
HIBP_TIMEOUT=5
